# ── Server ──────────────────────────────────────────────────────────────────
# Default to 5001 to avoid collisions with macOS AirPlay Receiver on port 5000
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── MySQL Connection ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword

# ── Database Names ───────────────────────────────────────────────────────────
# Central database (organizations, units registry, super admin, global audit)
DB_CENTRAL_NAME=vms_central
# Legacy fallback (kept for backward compatibility — maps to central internally)
DB_NAME=vms_central

# ── Auth & Security ──────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=24h
# A session can be refreshed while active, but never beyond this many hours after sign-in
SESSION_MAX_HOURS=24
# API requests allowed per 15 minutes (production only). Optional — these are the defaults.
#   API_RATE_LIMIT        per signed-in user
#   API_RATE_LIMIT_PUBLIC per IP address for requests without a sign-in (login page, public visitor form)
API_RATE_LIMIT=3000
API_RATE_LIMIT_PUBLIC=600
# 64 hex characters (32 bytes) for AES-256 field encryption:
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=
# Random string used to sign QR tokens:
QR_SECRET=change_this_to_a_secure_qr_secret_in_production

# ── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="VMS System" <your@gmail.com>

# ── App Meta ─────────────────────────────────────────────────────────────────
APP_NAME=VMS

# ── Unit DB Prefix ───────────────────────────────────────────────────────────
# Unit DBs are named as: <prefix><unit_code_lowercase>
# Example: vms_unit_ + hq = vms_unit_hq
UNIT_DB_PREFIX=vms_unit_

# ── AWS S3 (File Storage) ─────────────────────────────────────────────────────
# Visitor photos and QR codes are stored in S3 (not local disk).
# Set by your infrastructure/manager:
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ohpcvms
# For local development — add your IAM user access keys here (keep secret!):
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# On EC2/ECS/Lambda you can use an IAM role instead and omit the keys above.

# ── Firebase Admin SDK (public form: mobile-number OTP) ───────────────────────
# Firebase Phone Auth sends and checks the visitor's SMS code; the backend
# verifies the resulting Firebase token. These replace the
# firebase-service-account.json file (which must NEVER be committed to git).
# Copy the values from your service-account JSON:
#
#   "project_id"   → FIREBASE_PROJECT_ID
#   "client_email" → FIREBASE_CLIENT_EMAIL
#   "private_key"  → FIREBASE_PRIVATE_KEY
#
# IMPORTANT: When pasting private_key into a .env file, replace every real
# newline inside the key with a literal \n (backslash-n), so the entire key
# sits on one line. Example:
#   FIREBASE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
#
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END RSA PRIVATE KEY-----

# ── SMS Gateway (tender 1.3: notifications, approval alerts, reminders) ──────
# iCloudSMS (msg.icloudsms.com) for SMS notifications (approval alerts, walk-in
# alerts, reminders). Without these those SMS are recorded as FAILED; email and
# dashboard notifications still work. (The public form's OTP uses Firebase, above.)
# Each message text must match a DLT template registered for the sender ID.
ICLOUDSMS_AUTH_KEY=
ICLOUDSMS_SENDER_ID=STPL
ICLOUDSMS_ROUTE_ID=

# ── WhatsApp (Wishper — wishper.in) ──────────────────────────────────────────
# Every SMS notification (approval alerts, approvals / rejections, reminders) is
# also sent on WhatsApp; approvals include the gate-pass QR image. Link a WhatsApp
# number in the Wishper dashboard (scan the QR) and create an API key there.
# Leave WISHPER_API_KEY empty to keep WhatsApp off.
WISHPER_API_KEY=
WISHPER_API_URL=https://wapi.rextrox.in
# Session code of the linked number to send from (optional — default: any connected one)
WISHPER_SESSION=
# Wishper's anti-ban queue: rate-limited, human-like sending (recommended)
WISHPER_QUEUE=true

# ── Daily reminders (services/reminder.service.js) ────────────────────────────
# Hour of the day (IST, 0-23) after which the once-a-day reminder run happens.
REMINDER_HOUR=7
# Set to false to switch reminders off.
REMINDERS_ENABLED=true

# ── Yearly backup / archival (scripts/fy_archive.js, tender 1.1.10) ───────────
# Passphrase that encrypts backup and archive files (min 16 characters).
# Store it safely and hand it to OHPC separately from the files.
ARCHIVE_PASSPHRASE=
