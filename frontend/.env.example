# Environment — Frontend
# Copy this file to .env and fill in values for your environment.

# Backend API base URL
VITE_API_URL=http://localhost:5001/api

# Backend Socket.IO URL (must point to the same server as VITE_API_URL — without /api)
VITE_SOCKET_URL=http://localhost:5001

# Organisation shown on the sign-in page (optional — these are the defaults)
VITE_ORG_NAME=Odisha Hydro Power Corporation Ltd.
VITE_ORG_TAGLINE=A Government of Odisha Undertaking
